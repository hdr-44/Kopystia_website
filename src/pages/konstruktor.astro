---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import config from '../content/configurator.json';
---
<Base title="Конструктор капелюха">
  <div class="wrap">
    <h1>Конструктор капелюха</h1>
    <p class="placeholder-note">ЗРАЗОК: тестова модель і варіанти. Остаточний список елементів ще затверджується.</p>
    <div class="cfg">
      <div class="stage">
        <canvas id="hat-canvas" aria-label="3D-модель капелюха. Перетягуйте, щоб обертати."></canvas>
        <p class="fallback" hidden>Ваш браузер не підтримує 3D. Ви все одно можете обрати варіанти і надіслати запит.</p>
        <p class="hint muted">Перетягуйте, щоб обертати; колесо або два пальці — масштаб.</p>
      </div>
      <form class="options" id="cfg-options">
        {config.groups.map((g) => (
          <fieldset>
            <legend>{g.label}</legend>
            {g.options.map((o, i) => (
              <label class="opt">
                <input type="radio" name={g.id} value={o.id} checked={i === 0} />
                {'hex' in o && o.hex && <span class="swatch" style={`background:${o.hex}`}></span>}
                {o.label}
              </label>
            ))}
          </fieldset>
        ))}
      </form>
    </div>
    <h2 id="zapyt">Надіслати цей капелюх</h2>
    <p>Ваш вибір: <strong id="cfg-summary"></strong></p>
    <InquiryForm type="configurator" showImage descriptionLabel="Розмір, побажання, питання" />
  </div>
  <script id="cfg-data" type="application/json" set:html={JSON.stringify(config)} />
</Base>
<style>
  .cfg { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.5rem; align-items: start; }
  .stage { background: radial-gradient(circle at 50% 40%, #2a2622, var(--surface)); border: 1px solid var(--line); border-radius: var(--radius); }
  canvas { width: 100%; aspect-ratio: 4/3; display: block; touch-action: none; }
  .hint, .fallback { margin: .5rem 1rem; font-size: .9rem; }
  fieldset { border: 1px solid var(--line); border-radius: var(--radius); margin: 0 0 1rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  legend { padding: 0 .4rem; color: var(--accent); }
  .opt { display: flex; align-items: center; gap: .4rem; padding: .4em .8em; border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--accent); }
  .swatch { width: 1em; height: 1em; border-radius: 50%; border: 1px solid var(--muted); }
  @media (max-width: 820px) { .cfg { grid-template-columns: 1fr; } }
</style>
<script>
  import { initConfigurator } from '../scripts/configurator.ts';
  initConfigurator();
</script>
