[
  {
    "name": "theme_info",
    "theme_name": "Kopystia",
    "theme_version": "1.0.0",
    "theme_author": "Kopystia",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "courier_new_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#000000",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "muted_color",
        "default": "#F6F6F1",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#2F6B3A",
        "label": "t:labels.accent"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:labels.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 400,
        "step": 10,
        "unit": "px",
        "default": 160,
        "label": "t:labels.logo_width"
      },
      {
        "type": "text",
        "id": "location",
        "default": "Kyiv, UA",
        "label": "t:labels.location"
      },
      {
        "type": "richtext",
        "id": "contact",
        "default": "<p>Studio<br>Street address<br>City<br>+380 00 000 0000</p>",
        "label": "t:labels.contact"
      }
    ]
  },
  {
    "name": "t:general.homepage",
    "settings": [
      {
        "type": "collection",
        "id": "home_collection",
        "label": "t:labels.home_collection"
      }
    ]
  }
]
